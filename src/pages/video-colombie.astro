---
import "../styles/global.css";
const formUrl = "https://c807be1e.sibforms.com/v2/serve/MUIFALPt-g8PnWI8wH3pnYPqouMbUVhUjNhzj7oLNNfo3L-w1p_8sbmpdCkZTM4gmpGfXZSY5EYFS1ATYpbY41zr7xiJOAN3sVvKJ_YL6YCBRmIOIzZuesy4Sav1CmH4Zu9Z0era-LHIMqoTgLmSE7CB1-20CKSc1I67BbzgT6SAmW69-gIy1R0Vi6vhIm5sD0Vsd24cea6GucSpRA==";
const title = "Un autre visage de la Colombie, en vidéo | Maloka Experience";
const description = "Découvrez en vidéo l’un des plus beaux paysages que j’ai vus en Colombie. Recevez gratuitement le lien par email.";
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://maloka-experience.com/video-colombie/" />
    <meta property="og:image" content="https://maloka-experience.com/images/video-paramo-murillo-teaser.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="video-landing">
      <header class="landing-brand">
        <img src="/images/maloka-logo-symbol.png" width="40" height="40" alt="" />
        <span>Maloka Experience</span>
      </header>
      <main>
        <section class="signup-card" id="recevoir-video" aria-labelledby="video-title">
          <p class="landing-eyebrow">Vidéo offerte · Colombie</p>
          <h1 id="video-title">Je vous emmène hors des sentiers battus ?</h1>
          <p class="landing-intro">Laissez votre email ci-dessous pour recevoir gratuitement le lien de la vidéo.</p>
          <iframe src={formUrl} width="640" height="1120" title="Recevoir la vidéo gratuite par email" scrolling="auto" allowfullscreen></iframe>
          <p class="signature"><strong>Fabrice Dubesset</strong><br />Créateur d’Instinct Voyageur, plus de 15 ans d’expérience en Colombie.</p>
        </section>
      </main>
      <footer>
        <span>© Maloka Experience</span>
        <a href="/politique-confidentialite/">Confidentialité</a>
        <a href="/mentions-legales/">Mentions légales</a>
      </footer>
    </div>
  </body>
</html>
<style>
  .video-landing { min-height:100vh; background:#f0f2f7; padding:24px 16px; }
  .landing-brand { display:flex; align-items:center; justify-content:center; gap:12px; color:#244638; font-weight:800; letter-spacing:.03em; margin:0 auto 28px; }
  .landing-brand img { object-fit:contain; }
  main { max-width:640px; margin:auto; text-align:center; }
  .landing-eyebrow { color:#526747; font-size:.72rem; font-weight:800; text-transform:uppercase; letter-spacing:.14em; margin:0 0 12px; }
  h1 { font-family:"Cormorant Garamond",Georgia,serif; color:#244638; font-size:clamp(2rem,4vw,2.8rem); font-weight:600; line-height:1.1; margin:0; }
  .landing-intro { font-size:.95rem; line-height:1.6; color:#50584e; max-width:450px; margin:16px auto 0; }
  iframe { display:block; border:0; width:100%; height:1120px; margin:auto; }
  .signature { margin:0; font-size:.8rem; line-height:1.7; color:#62695e; }
  .signature strong { color:#244638; font-size:.9rem; }
  footer { margin:26px auto 0; display:flex; justify-content:center; gap:20px; flex-wrap:wrap; color:#62695e; font-size:.72rem; }
  footer a { color:inherit; }
  a:focus-visible { outline:3px solid #c18a68; outline-offset:5px; }
  @media(max-width:600px) {
    .video-landing { padding:20px 8px; }
    .landing-brand { font-size:.85rem; }
    h1, .landing-intro { margin-left:16px; margin-right:16px; }
    iframe { height:1280px; }
    footer { gap:14px; }
  }
  @media(max-width:380px) { iframe { height:1400px; } }
</style>
